# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
# See docs/environment-variables.md for full details on each variable.

# Supabase project URL (safe to expose to the browser — not a secret)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (safe to expose to the browser — currently
# unused by any live code path; see docs/environment-variables.md)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Supabase service-role key — SERVER-ONLY, bypasses Row Level Security.
# Never expose this to the browser. Rotate immediately if ever suspected leaked.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# HTTP Basic Auth credentials for the /admin perimeter (proxy.ts) — SERVER-ONLY
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Configured but not currently read by any code (reserved for future
# analytics/SEO work) — see docs/environment-variables.md
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Canonical site URL — used to build the admin link included in internal
# support-request alert emails (lib/transactional-email.ts). Safe to expose
# to the browser; not a secret.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Resend API key for transactional support-request emails — SERVER-ONLY.
# Never expose this to the browser. Leave blank in any environment where
# support-request emails should be skipped (e.g. local dev without a
# provider account) — the app fails safe and still creates/updates support
# requests normally, recording each notification attempt as "skipped".
RESEND_API_KEY=

# Display name used as the email "From" header for support-request emails.
EMAIL_FROM_NAME=Amber Global Energy

# Verified sending address for support-request emails — SERVER-ONLY. Must be
# a domain/address verified with the Resend account above.
EMAIL_FROM_ADDRESS=

# Public-facing support inbox shown inside email bodies (already shown in
# the admin Client Support Center UI — see app/admin/_components/support-request-card.tsx).
SUPPORT_EMAIL=support@amberglobalenergy.in

# Fallback recipient for the internal "new support request" alert when the
# request has no assigned broker yet, or the assigned broker has no email on
# file — SERVER-ONLY.
SUPPORT_NOTIFICATION_EMAIL=
